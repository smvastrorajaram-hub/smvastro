rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        (request.auth.uid == "TwjeEIFS3Zcf1SxboLZoujm91Ky2" ||
         exists(/databases/$(database)/documents/smv_admins/$(request.auth.uid)) ||
         (exists(/databases/$(database)/documents/smv_users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/smv_users/$(request.auth.uid)).data.role == "admin"));
    }

    match /smv_counters/{counterId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(["lastNumber","updatedAt"]) &&
        request.resource.data.lastNumber == 1;
      allow update: if signedIn() &&
        request.resource.data.keys().hasOnly(["lastNumber","updatedAt"]) &&
        request.resource.data.lastNumber == resource.data.lastNumber + 1;
      allow delete: if false;
    }

    match /smv_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","phone","mobile","emailVerificationRequired","updatedAt"]));
    }

    match /smv_astrologers/{uid} {
      allow read: if resource.data.status == "approved" || (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.status == "pending";
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","specialization","expertise","experience","about","bio","photoData"]));
    }

    match /smv_payouts/{uid} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.status == "pending_admin_review";
      allow update: if isAdmin() ||
        (signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.status == "pending_admin_review");
      allow delete: if isAdmin();
    }

    match /smv_admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth.uid == "TwjeEIFS3Zcf1SxboLZoujm91Ky2";
    }

    match /smv_blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /smv_settings/{docId} {
      allow read: if isAdmin() || docId == "question";
      allow write: if isAdmin();
    }

    match /smv_notifications/{id} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin() || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /smv_questions/{questionId} {
      allow create: if signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == "awaiting_payment";

      allow read: if signedIn() &&
        (resource.data.customerId == request.auth.uid ||
         resource.data.astrologerId == request.auth.uid ||
         isAdmin());

      allow update: if isAdmin() ||
        (signedIn() && resource.data.customerId == request.auth.uid &&
         resource.data.status == "answered" &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["reviewed","reviewSubmittedAt"]));
    }

    match /smv_appointments/{appointmentId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid && request.resource.data.status == "new";
      allow read: if signedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    match /smv_shop_categories/{categoryId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /smv_products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /smv_withdrawals/{withdrawalId} {
      allow read: if signedIn() && (resource.data.astrologerId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /smv_announcements/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /smv_reviews/{reviewId} {
      allow read: if (resource.data.approved == true) ||
                  isAdmin() ||
                  (signedIn() && (resource.data.customerId == request.auth.uid || resource.data.astrologerId == request.auth.uid));

      // Customer may submit exactly one review for their own answered question.
      // The review document ID is questionId_customerUid.
      allow create: if signedIn() &&
        request.resource.data.questionId is string &&
        request.resource.data.questionId != "" &&
        reviewId == request.resource.data.questionId + "_" + request.auth.uid &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.astrologerId is string &&
        request.resource.data.astrologerId != "" &&
        request.resource.data.approved == false &&
        request.resource.data.status == "pending" &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        exists(/databases/$(database)/documents/smv_questions/$(request.resource.data.questionId)) &&
        get(/databases/$(database)/documents/smv_questions/$(request.resource.data.questionId)).data.customerId == request.auth.uid &&
        get(/databases/$(database)/documents/smv_questions/$(request.resource.data.questionId)).data.status == "answered" &&
        get(/databases/$(database)/documents/smv_questions/$(request.resource.data.questionId)).data.astrologerId == request.resource.data.astrologerId;

      allow update, delete: if isAdmin();
    }
  }
}
